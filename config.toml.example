# config.toml — configuración del bot de trailing take-profit para pump.fun
# ---------------------------------------------------------------------------

[general]
# false = todo simulado (no gasta SOL real).
# true  = opera en real vía la Lightning API de PumpPortal (requiere API key).
live = false

# El bot se suscribe (subscribe_trade) al feed en vivo de PumpPortal para
# este mint ANTES de comprar, y espera el tiempo que haga falta a que
# llegue el primer trade real para usar ESE precio como entrada. Es la
# ÚNICA fuente de precio del bot: no hay on-chain ni DexScreener.

# Ruta al .csv donde se va agregando una fila por cada orden CERRADA
# (venta confirmada, real o simulada): mint, precio de entrada/salida,
# PnL %%, SOL recibidos, duración de la posición y motivo del cierre.
# Se crea solo si no existe. "" desactiva el historial.
# En Windows, usa barras normales ("C:/bots/historial.csv") o comillas
# simples ('C:\bots\historial.csv'): en una cadena TOML con comillas
# dobles, la barra invertida es un escape y da error de parseo.
trade_history_csv = "trade_history.csv"

# Cada cuántos segundos se imprime el estado de la posición (precio actual,
# máximo, nivel de venta y PnL %%), sin depender de que lleguen trades nuevos
# en ese momento. También marca el ritmo del log de espera cuando
# entry_dip_pct > 0.
status_interval_seconds = 5.0

# Máximo de posiciones activas a la vez (contando las retomadas al
# arrancar). Intentar abrir una más da error, venga de la web, de ctl.py o
# de -m.
max_open_positions = 10

# Base de datos (SQLite) con el estado de las posiciones. Gracias a ella,
# si el bot se para (Ctrl+C, un corte de luz, un cuelgue), al volver a
# arrancarlo retoma las posiciones que quedaron abiertas, sin volver a
# comprar. "" la desactiva (no recomendado).
state_db = "pepump.db"

[trade]
# Cantidad de SOL a comprar.
buy_sol = 0.05

# Slippage permitido, en porcentaje.
slippage = 15

# Priority fee / tip, en SOL. Súbelo si las transacciones no entran rápido.
priority_fee = 0.00001

# Pool/exchange: "pump", "raydium", "pump-amm", "launchlab", "raydium-cpmm", "bonk" o "auto".
pool = "auto"

# Tope de SOL por posición. Red de seguridad contra un error de dedo al
# abrir desde la web (10 en vez de 0.10): ninguna compra puede superarlo, ni
# desde la web, ni desde ctl.py, ni el buy_sol de este archivo. Solo se
# cambia aquí, a propósito.
max_buy_sol = 0.5

# Si una venta falla (típicamente slippage excedido: cuando salta un stop el
# precio suele estar cayendo rápido), el bot la reintenta subiendo en cada
# intento el slippage (+10 puntos) y el priority fee (x4), hasta estos
# topes. Con los valores de arriba: slippage 15 -> 25 -> 35 -> 45 -> 50 y
# fee 0.00001 -> 0.00004 -> 0.00016 -> 0.00064 -> 0.001 SOL. Nunca bajan
# de slippage / priority_fee. Solo afectan a las VENTAS, no a la compra.
max_sell_slippage = 50
max_sell_priority_fee = 0.001

[strategy]
# Subida %% desde el precio de entrada necesaria para "armar" el trailing-stop.
activation_pct = 10.0

# Una vez armado, retroceso %% desde el máximo alcanzado que dispara la venta.
trailing_pct = 15.0

# Stop-loss "duro" (%%) que aplica SOLO mientras el trailing todavía no se armó
# (protege por si el precio nunca sube y se desploma desde el arranque).
initial_stop_pct = 25.0

# Baja %% que se espera ANTES de comprar, medida desde el precio de
# referencia (el primer precio que llega al arrancar el bot).
# 0 (default)  = compra al instante al precio de referencia (normal).
# > 0 (ej. 5)  = NO compra en la referencia; espera a que el precio baje ese
#                %% desde ahí (referencia * (1 - entry_dip_pct/100)) y solo
#                entonces entra. Sin timeout: si el precio nunca baja tanto, el
#                bot queda esperando indefinidamente (cancela con Ctrl+C).
entry_dip_pct = 0.0

# Contra qué precio de entrada se miden activation_pct e initial_stop_pct:
# "real"   = el precio que pagaste DE VERDAD (incluye comisiones de pump.fun
#            y PumpPortal, priority fee y rent de la cuenta de token), leído
#            de la transacción de compra. +10% significa +10% de ganancia
#            real. Con ~4% de costes de entrada, el mercado tiene que subir
#            ~14% para armar el trailing, y el stop-loss salta antes.
# "market" = el precio de mercado al comprar (el % que muestra pump.fun),
#            sin contar costes. Es como funcionaba antes.
# En modo simulado los dos son iguales (no hay comisiones reales).
strategy_price_basis = "real"

[pumpportal]
# API key de PumpPortal. Se genera en pumpportal.fun y está asociada a una
# wallet ya fondeada. ¡OBLIGATORIA siempre, aunque live = false! El bot usa
# ÚNICAMENTE subscribeTokenTrade para el precio, que es un stream medido
# (0.01 SOL cada 10.000 eventos) y exige API key + wallet con >= 0.02 SOL
# para funcionar. Sin key, la conexión no da error pero tampoco entrega
# trades: el bot se queda esperando para siempre.
# Si la dejas vacía, el bot también busca la variable de entorno
# PUMPPORTAL_API_KEY (más seguro que dejarla escrita en este archivo).
api_key = ""

# Dirección PÚBLICA de la wallet de esa api_key (la que ves en Phantom,
# Solflare...; NUNCA la clave privada). Opcional: la API de PumpPortal no la
# da, así que sin esto el bot solo la conoce después de la primera compra
# real. Con ella, el panel web muestra el saldo desde el arranque y, antes de
# cada compra real, comprueba que haya SOL suficiente.
wallet_address = ""

[onchain]
# Cuántos segundos se espera el precio por el feed en vivo ANTES de recurrir
# al fallback on-chain, PARA LA ENTRADA (todavía sin posición abierta). Solo
# cuenta desde que llegó el ack de suscripción: si ya llegó el ack pero no
# aparece ningún trade real, lo más probable es que el mint ya haya migrado
# a PumpSwap, caso que subscribeTokenTrade no cubre. Mientras el mint sigue
# en bonding curve el feed funciona bien y esto casi nunca se cumple.
live_feed_timeout_seconds = 5.0

# Si pasan estos segundos sin ningún trade nuevo por subscribeTokenTrade
# CON LA POSICIÓN YA ABIERTA, el bot sospecha que el mint migró de la
# bonding curve de pump.fun a PumpSwap a mitad de camino (el socket sigue
# abierto pero deja de mandar trades para ese mint, sin ningún error) y
# hace una consulta on-chain puntual para confirmarlo. Si hay un pool con
# precio válido, pasa a polling on-chain (ver onchain_poll_interval_seconds
# más abajo) para no perderse el trailing-stop/stop-loss. Si no, sigue
# esperando el feed en vivo (probablemente solo poco volumen momentáneo).
# Es el tiempo máximo que el bot puede pasar sin enterarse del precio si el
# feed deja de entregar sin avisar: más bajo reacciona antes, a cambio de
# dos consultas baratas al RPC (getAccountInfo) por cada pausa de volumen.
stall_timeout_seconds = 10.0

# Cada cuántos segundos se consulta el precio on-chain de PumpSwap mientras
# el bot está en modo fallback (mint migrado, ya sea desde la entrada o a
# mitad de la posición vía stall_timeout_seconds de arriba).
onchain_poll_interval_seconds = 5.0

# RPC de Solana usado únicamente para leer, on-chain, las reservas del pool
# de PumpSwap cuando el mint ya migró. Un endpoint público gratuito alcanza
# para esto, pero es lento/rate-limited; para uso serio conviene uno propio
# (Helius, QuickNode, etc.).
solana_rpc_url = "https://api.mainnet-beta.solana.com"

# Tiempo TOTAL, en segundos, que el bot espera el precio de entrada antes
# de abortar la entrada del todo (no compra nada). Cubre la espera después
# del ack de suscripción: ciclos de live_feed_timeout_seconds + intentos de
# fallback on-chain, uno tras otro, hasta cumplir este total.
entry_wait_timeout_seconds = 60.0

# Después de mandar una compra/venta REAL a la Lightning API, cuántos
# segundos se espera a que la transacción confirme on-chain antes de darla
# por fallida, y cada cuánto se consulta su estado mientras tanto. Hace
# falta porque PumpPortal puede devolver un 200 OK con firma de forma
# "optimista", antes de saber si la tx va a confirmar o a revertir (p. ej.
# por slippage excedido).
tx_confirm_timeout_seconds = 30.0
tx_confirm_poll_interval_seconds = 2.0

[web]
# Contraseña del panel web (python run.py ... --web). OPCIONAL: vacía, el
# panel no pide nada. Si la pones, hay que entrar con ella para verlo y
# para cerrar posiciones.
# Ojo: desde la web se pueden CERRAR posiciones (vender). Sin contraseña y
# con el panel abierto a la red (--web-host 192.168.x.x o 0.0.0.0),
# cualquiera en esa red puede hacerlo.
# Si la dejas vacía aquí, también se busca la variable de entorno
# PEPUMP_WEB_PASSWORD (más seguro que dejarla escrita en este archivo).
web_password = ""
