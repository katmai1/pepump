# config.toml — configuración del bot de trailing take-profit para pump.fun
# ---------------------------------------------------------------------------

[general]
# false = todo simulado (no gasta SOL real).
# true  = opera en real vía la Lightning API de PumpPortal (requiere API key).
live = false

# El bot se suscribe (subscribe_trade) al feed en vivo de PumpPortal para
# este mint ANTES de comprar, y espera el tiempo que haga falta a que
# llegue el primer trade real para usar ESE precio como entrada. Es la
# ÚNICA fuente de precio del bot: no hay on-chain ni DexScreener.

# Ruta al .csv donde se va agregando una fila por cada orden CERRADA
# (venta confirmada, real o simulada): mint, precio de entrada/salida,
# PnL %%, SOL recibidos, duración de la posición y motivo del cierre.
# Se crea solo si no existe. "" desactiva el historial.
trade_history_csv = "trade_history.csv"

[trade]
# Cantidad de SOL a comprar.
buy_sol = 0.05

# Slippage permitido, en porcentaje.
slippage = 15

# Priority fee / tip, en SOL. Subilo si las transacciones no entran rápido.
priority_fee = 0.00001

# Pool/exchange: "pump", "raydium", "pump-amm", "launchlab", "raydium-cpmm", "bonk" o "auto".
pool = "auto"

[strategy]
# Subida %% desde el precio de entrada necesaria para "armar" el trailing-stop.
activation_pct = 10.0

# Una vez armado, retroceso %% desde el máximo alcanzado que dispara la venta.
trailing_pct = 15.0

# Stop-loss "duro" (%%) que aplica SOLO mientras el trailing todavía no se armó
# (protege por si el precio nunca sube y se desploma desde el arranque).
initial_stop_pct = 25.0

# Baja %% que se espera ANTES de comprar, medida desde el precio de
# referencia (el primer precio que llega al arrancar el bot).
# 0 (default)  = compra de una al precio de referencia (comportamiento normal).
# > 0 (ej. 5)  = NO compra en la referencia; espera a que el precio baje ese
#                %% desde ahí (referencia * (1 - entry_dip_pct/100)) y recién
#                ahí entra. Sin timeout: si el precio nunca baja tanto, el
#                bot queda esperando indefinidamente (cancelá con Ctrl+C).
entry_dip_pct = 0.0

[pumpportal]
# API key de PumpPortal. Se genera en pumpportal.fun y está asociada a una
# wallet ya fondeada. ¡OBLIGATORIA siempre, aunque live = false! El bot usa
# ÚNICAMENTE subscribeTokenTrade para el precio, que es un stream medido
# (0.01 SOL cada 10.000 eventos) y exige API key + wallet con >= 0.02 SOL
# para funcionar. Sin key, la conexión no da error pero tampoco entrega
# trades: el bot se queda esperando para siempre.
# Si la dejás vacía acá, el bot también busca la variable de entorno
# PUMPPORTAL_API_KEY (más seguro que dejarla escrita en este archivo).
api_key = ""

[onchain]
# Si pasan estos segundos sin ningún trade nuevo por subscribeTokenTrade
# CON LA POSICIÓN YA ABIERTA, el bot sospecha que el mint migró de la
# bonding curve de pump.fun a PumpSwap a mitad de camino (el socket sigue
# abierto pero deja de mandar trades para ese mint, sin ningún error) y
# hace una consulta on-chain puntual para confirmarlo. Si hay un pool con
# precio válido, pasa a polling on-chain (ver onchain_poll_interval_seconds
# más abajo) para no perderse el trailing-stop/stop-loss. Si no, sigue
# esperando el feed en vivo (probablemente solo poco volumen momentáneo).
stall_timeout_seconds = 20.0

# Cada cuántos segundos se consulta el precio on-chain de PumpSwap mientras
# el bot está en modo fallback (mint migrado, ya sea desde la entrada o a
# mitad de la posición vía stall_timeout_seconds de arriba).
onchain_poll_interval_seconds = 5.0

# RPC de Solana usado únicamente para leer, on-chain, las reservas del pool
# de PumpSwap cuando el mint ya migró. Un endpoint público gratuito alcanza
# para esto, pero es lento/rate-limited; para uso serio conviene uno propio
# (Helius, QuickNode, etc.).
solana_rpc_url = "https://api.mainnet-beta.solana.com"

# Tiempo TOTAL, en segundos, que el bot espera el precio de entrada antes
# de abortar la entrada del todo (no compra nada). Cubre la espera después
# del ack de suscripción: ciclos de live_feed_timeout_seconds + intentos de
# fallback on-chain, uno tras otro, hasta cumplir este total.
entry_wait_timeout_seconds = 60.0